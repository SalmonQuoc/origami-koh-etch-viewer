{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": false,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["src/app/*.ts", "src/core/*.ts", "src/types/*.d.ts"]
}
